# Supabase
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# hCaptcha — get keys at https://dashboard.hcaptcha.com
# Test keys (always pass): site=10000000-ffff-ffff-ffff-000000000001 / secret=0x0000000000000000000000000000000000000000
VITE_HCAPTCHA_SITE_KEY=your-hcaptcha-site-key

# Razorpay — get test keys at https://dashboard.razorpay.com/app/keys
# Test key IDs start with rzp_test_
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Edge Function secrets (set in Supabase Dashboard → Settings → Edge Functions → Secrets)
# HCAPTCHA_SECRET_KEY=your-hcaptcha-secret-key
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# OWNER_EMAIL=owner@maharajarestaurant.in
# RAZORPAY_KEY_ID=rzp_test_your_key_id_here
# RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase)

# Sentry (optional — leave blank to disable in local dev)
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=maharaja
SENTRY_PROJECT=maharaja-web

# App
VITE_APP_VERSION=0.0.0
